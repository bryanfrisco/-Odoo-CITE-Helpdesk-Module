<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Jam kerja SLA CITE: Senin-Jumat 08:00-12:00 & 13:00-17:00.
             Sabtu & Minggu TIDAK dihitung sebagai jam kerja, sehingga
             deadline SLA melompati akhir pekan.

             Kalender sendiri (bukan kalender company) agar tidak mengubah
             perhitungan modul lain yang memakai kalender company, dan
             company_id kosong supaya bisa dipakai lintas 3 company.
             Dipasang ke tim CITE lewat helpdesk_team.xml + backfill
             _cite_post_deploy_sync untuk database yang sudah terpasang. -->
        <record id="resource_calendar_cite" model="resource.calendar">
            <field name="name">CITE Helpdesk Working Hours (Sen-Jum)</field>
            <field name="company_id" eval="False"/>
            <field name="tz">Asia/Jakarta</field>
            <field name="hours_per_day">8.0</field>
            <field name="attendance_ids" eval="[(5, 0, 0)]"/>
        </record>

        <record id="cal_att_mon_am" model="resource.calendar.attendance">
            <field name="name">Senin Pagi</field><field name="dayofweek">0</field>
            <field name="hour_from">8</field><field name="hour_to">12</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_mon_pm" model="resource.calendar.attendance">
            <field name="name">Senin Siang</field><field name="dayofweek">0</field>
            <field name="hour_from">13</field><field name="hour_to">17</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_tue_am" model="resource.calendar.attendance">
            <field name="name">Selasa Pagi</field><field name="dayofweek">1</field>
            <field name="hour_from">8</field><field name="hour_to">12</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_tue_pm" model="resource.calendar.attendance">
            <field name="name">Selasa Siang</field><field name="dayofweek">1</field>
            <field name="hour_from">13</field><field name="hour_to">17</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_wed_am" model="resource.calendar.attendance">
            <field name="name">Rabu Pagi</field><field name="dayofweek">2</field>
            <field name="hour_from">8</field><field name="hour_to">12</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_wed_pm" model="resource.calendar.attendance">
            <field name="name">Rabu Siang</field><field name="dayofweek">2</field>
            <field name="hour_from">13</field><field name="hour_to">17</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_thu_am" model="resource.calendar.attendance">
            <field name="name">Kamis Pagi</field><field name="dayofweek">3</field>
            <field name="hour_from">8</field><field name="hour_to">12</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_thu_pm" model="resource.calendar.attendance">
            <field name="name">Kamis Siang</field><field name="dayofweek">3</field>
            <field name="hour_from">13</field><field name="hour_to">17</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_fri_am" model="resource.calendar.attendance">
            <field name="name">Jumat Pagi</field><field name="dayofweek">4</field>
            <field name="hour_from">8</field><field name="hour_to">12</field>
            <field name="day_period">morning</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
        <record id="cal_att_fri_pm" model="resource.calendar.attendance">
            <field name="name">Jumat Siang</field><field name="dayofweek">4</field>
            <field name="hour_from">13</field><field name="hour_to">17</field>
            <field name="day_period">afternoon</field>
            <field name="calendar_id" ref="resource_calendar_cite"/>
        </record>
    </data>
</odoo>
